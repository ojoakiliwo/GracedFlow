{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install",
  "outputDirectory": "client/dist",
  "framework": null,
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/sunday_reminder", "schedule": "0 17 * * 6" },
    { "path": "/api/cron/prayer_reminder", "schedule": "0 5 * * 3" },
    { "path": "/api/cron/celebrations", "schedule": "0 6 * * *" }
  ]
}
