{
  "name": "@gracedflow/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/listen.js",
  "scripts": {
    "dev": "tsx watch src/listen.ts",
    "build": "tsc -p tsconfig.build.json && mkdir -p client/dist && printf '%s\\n' '<!doctype html><title>GracedFlow API</title>' > client/dist/index.html",
    "vercel-build": "npm run build",
    "start": "node dist/listen.js",
    "seed": "tsx src/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.16",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
