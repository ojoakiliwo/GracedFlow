# Copy to .env and fill in to enable real integrations.
# Everything works in dry-run mode without these.

# Database (Postgres). Locally this points at your dev Postgres; in production use
# Vercel Postgres / Neon (their dashboard provides this connection string).
DATABASE_URL=postgres://igc:igc@127.0.0.1:5432/gracedflow

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Server
PORT=3001

# Public URL of the deployed app (used for Paystack redirect callbacks)
APP_URL=http://localhost:5173

# Secret shared with the scheduler (Vercel Cron sends it as a Bearer token) so
# only authorized callers can trigger /api/cron/* automations.
CRON_SECRET=change-me-to-a-long-random-string

# SMS via Twilio (leave provider=dryrun to simulate)
SMS_PROVIDER=dryrun
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Email via SMTP (leave provider=dryrun to simulate)
EMAIL_PROVIDER=dryrun
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Infinitely Graced Church <noreply@igc.church>

# Social platforms that have credentials configured (comma-separated)
SOCIAL_CONNECTED=

# Payments (leave empty for simulated giving).
# provider auto-selects: flutterwave if FLW_CLIENT_ID set, else paystack, else dryrun.
PAYMENT_PROVIDER=
PAYMENT_CURRENCY=NGN

# Flutterwave V4 (OAuth). Client ID + Secret from your Flutterwave dashboard.
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
# Encryption key: only needed for direct card charges, not the hosted checkout.
FLW_ENCRYPTION_KEY=
# Secret hash you set on Flutterwave dashboard → Webhooks (secures webhooks).
FLW_SECRET_HASH=
# Production base URL; override if your dashboard shows a different one.
FLW_BASE_URL=https://api.flutterwave.cloud/f4bexperience

# Paystack (alternative provider)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Public URL of the client app (used for payment redirect callbacks)
APP_URL=http://localhost:5173

# Automations
SCHEDULER_ENABLED=true
TZ_NAME=Africa/Lagos

# Giving details shown on the public giving page
GIVING_BANK_NAME=First Bank
GIVING_ACCOUNT_NAME=Infinitely Graced Church
GIVING_ACCOUNT_NUMBER=0000000000
GIVING_ONLINE_URL=
