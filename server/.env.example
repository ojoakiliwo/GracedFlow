# Copy to .env and fill in to enable real integrations.
# Everything works in dry-run mode without these.

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Server
PORT=3001

# SMS via Twilio (leave provider=dryrun to simulate)
SMS_PROVIDER=dryrun
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Email via SMTP (leave provider=dryrun to simulate)
EMAIL_PROVIDER=dryrun
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Infinitely Graced Church <noreply@igc.church>

# Social platforms that have credentials configured (comma-separated)
SOCIAL_CONNECTED=

# Payments via Paystack (leave keys empty for simulated giving)
# Get keys from https://dashboard.paystack.com/#/settings/developers
PAYMENT_PROVIDER=dryrun
PAYMENT_CURRENCY=NGN
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Public URL of the client app (used for Paystack callback redirect)
APP_URL=http://localhost:5173

# Automations
SCHEDULER_ENABLED=true
TZ_NAME=Africa/Lagos

# Giving details shown on the public giving page
GIVING_BANK_NAME=First Bank
GIVING_ACCOUNT_NAME=Infinitely Graced Church
GIVING_ACCOUNT_NUMBER=0000000000
GIVING_ONLINE_URL=
