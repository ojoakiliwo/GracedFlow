# Copy to .env and fill in to enable real integrations.
# Everything works in dry-run mode without these.

# Database (Postgres). Locally this points at your dev Postgres; in production use
# Vercel Postgres / Neon (their dashboard provides this connection string).
DATABASE_URL=postgres://igc:igc@127.0.0.1:5432/gracedflow

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# First church administrator (created on boot if no one has this email yet)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
# Set to true only if you want the old sample church (fake members, gifts, projects).
# On Vercel production this is ignored unless ALLOW_DEMO_DATA=true.
SEED_DEMO=false
# ALLOW_DEMO_DATA=true

# Server
PORT=3001

# Public URL of the deployed app (used for checkout redirect callbacks)
APP_URL=http://localhost:5173

# Secret shared with the scheduler (Vercel Cron sends it as a Bearer token) so
# only authorized callers can trigger /api/cron/* automations.
CRON_SECRET=change-me-to-a-long-random-string

# SMS — cheapest path is BulkSMS Nigeria. Termii and Twilio also work.
# SMS_PROVIDER=bulksmsnigeria
BULKSMS_API_TOKEN=
BULKSMS_SENDER_ID=IGC
# BULKSMS_GATEWAY=direct-corporate
# TERMII_API_KEY=
# TERMII_SENDER_ID=IGC
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Email — Gmail or Brevo SMTP. Live as soon as SMTP_HOST + SMTP_USER are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Infinitely Graced Church <noreply@igc.church>

# Social platforms that have credentials configured (comma-separated)
SOCIAL_CONNECTED=

# Payments — Flutterwave v4 and Paystack can both be live at once.
# Leave credentials empty for simulated giving.
# PAYMENT_PROVIDER is only the default checkout when the donor does not pick one.
# PAYMENT_PROVIDER=flutterwave
PAYMENT_CURRENCY=NGN

# Flutterwave dashboard → Settings → API Keys (v4 Live)
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_ENCRYPTION_KEY=
# Optional. Not required if another project already owns the Flutterwave webhook.
FLW_SECRET_HASH=
FLW_ENV=live

# Paystack dashboard → Settings → API Keys & Webhooks
# Webhook is optional — gifts confirm when the donor returns from checkout.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Automations
SCHEDULER_ENABLED=true
TZ_NAME=Africa/Lagos

# Giving details shown on the public giving page (leave empty until you have real ones)
GIVING_BANK_NAME=
GIVING_ACCOUNT_NAME=
GIVING_ACCOUNT_NUMBER=
GIVING_ONLINE_URL=
