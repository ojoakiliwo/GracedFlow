# Copy to .env and fill in to enable real integrations.
# Everything works in dry-run mode without these.

# Database (Postgres). Locally this points at your dev Postgres; in production use
# Vercel Postgres / Neon (their dashboard provides this connection string).
DATABASE_URL=postgres://igc:igc@127.0.0.1:5432/gracedflow

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Server
PORT=3001

# Public URL of the deployed app (used for checkout redirect callbacks)
APP_URL=http://localhost:5173

# Secret shared with the scheduler (Vercel Cron sends it as a Bearer token) so
# only authorized callers can trigger /api/cron/* automations.
CRON_SECRET=change-me-to-a-long-random-string

# SMS via Twilio (leave provider=dryrun to simulate)
SMS_PROVIDER=dryrun
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Email via SMTP (leave provider=dryrun to simulate)
EMAIL_PROVIDER=dryrun
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Infinitely Graced Church <noreply@igc.church>

# Social platforms that have credentials configured (comma-separated)
SOCIAL_CONNECTED=

# Payments — Flutterwave v4 (preferred) or Paystack
# Leave credentials empty for simulated giving.
# Flutterwave dashboard → Settings → API Keys (v4 Live):
#   Client ID, Client Secret, Encryption key
# flutterwave | paystack | dryrun — if unset, auto-detects from keys below
# PAYMENT_PROVIDER=flutterwave
PAYMENT_CURRENCY=NGN
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_ENCRYPTION_KEY=
# Optional. Only needed if this app owns the Flutterwave webhook URL.
# Gifts already confirm when the donor returns from checkout.
FLW_SECRET_HASH=
# live (default, for v4 Live keys) or sandbox
FLW_ENV=live
# Optional override if Flutterwave gives you a different API host
# FLW_BASE_URL=https://f4bexperience.flutterwave.com

# Paystack (optional alternative)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Automations
SCHEDULER_ENABLED=true
TZ_NAME=Africa/Lagos

# Giving details shown on the public giving page
GIVING_BANK_NAME=First Bank
GIVING_ACCOUNT_NAME=Infinitely Graced Church
GIVING_ACCOUNT_NUMBER=0000000000
GIVING_ONLINE_URL=
